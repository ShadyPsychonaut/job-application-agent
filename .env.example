# Groq API key: create one in the Groq Console. Keep .env private.
GROQ_API_KEY=
# Requested model. Groq docs currently mark this model Enterprise-only; see README if unavailable.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1

# auto: use Groq when GROQ_API_KEY is configured, otherwise use local rules.
# rules: no network calls. llm: require a Groq API key and surface failures.
JOB_AGENT_SCORING_MODE=auto

# Privacy default: actual resume text stays local unless you explicitly opt in.
# Set to true only after reviewing what will be sent to Groq.
JOB_AGENT_SHARE_RESUME_WITH_LLM=false
